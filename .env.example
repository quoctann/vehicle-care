# Backend local development. Kubernetes should inject these values directly.
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_REDIRECT_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL=720h
SYNC_MAX_BATCH_SIZE=100
SYNC_MAX_PAGE_SIZE=100
MOCK_AUTH_ENABLED=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=dbuser
DB_PASSWORD=mypassword
DB_NAME=mydbname
DB_SSLMODE=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_MAX_RETRIES=3
