# Backend local development. Kubernetes should inject these values directly.
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_REDIRECT_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL=720h
SYNC_MAX_BATCH_SIZE=100
SYNC_MAX_PAGE_SIZE=100
MOCK_AUTH_ENABLED=true
AUTO_MIGRATE=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=dbuser
DB_PASSWORD=mypassword
DB_NAME=mydbname
DB_SSLMODE=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_MAX_RETRIES=3
## Google OAuth/OIDC (disabled until a Google web OAuth client is configured).
# Register this exact backend callback in Google Cloud; no frontend callback.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# Comma-separated reverse-proxy IPs/CIDRs. Empty = ignore all forwarding headers.
# Production: set only nginx/load-balancer IPs or its narrowly scoped network.
# Supports IPv4 and IPv6. Never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXIES=

# Distributed token bucket: shared across replicas. Auth has a separate 30/min bucket.
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_BURST=120

# Optional LGTM telemetry (OTLP HTTP/protobuf, not gRPC).
# make dev-observability && make dev-be-observed enables local traces/metrics/logs.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=vehicle-care-api
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Inject OTEL_EXPORTER_OTLP_HEADERS for collector authentication; never commit them.
# LOG_FILE duplicates JSON stdout for local Alloy; parent directory must exist.
LOG_FILE=

# Account mail. Local Mailpit inbox: http://localhost:8025 (make dev-infra).
# Production: trusted SMTP provider, STARTTLS=true, HTTPS frontend origin,
# COOKIE_SECURE=true, real sender address and credentials injected by your secret manager.
# Supports STARTTLS (usually port 587), not implicit TLS/SMTPS on port 465.
# Forgot/resend always consume SMTP_TIMEOUT before replying (unless client cancels).
MAIL_FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@vehicle-care.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT=5s
