{
  "uid": "vehicle-care-api",
  "title": "Vehicle Care API",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["vehicle-care"],
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "title": "Requests / second", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (http_route) (rate(http_server_request_count_total[5m]))", "legendFormat": "{{http_route}}"}]
    },
    {
      "id": 2, "title": "HTTP errors and throttles / second", "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (http_response_status_code) (rate(http_server_request_count_total{http_response_status_code=~\"429|5..\"}[5m]))", "legendFormat": "{{http_response_status_code}}"}]
    },
    {
      "id": 3, "title": "P95 request latency (seconds)", "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket[5m])))", "legendFormat": "{{http_route}}"}]
    },
    {
      "id": 4, "title": "API logs (trace IDs link to Tempo)", "type": "logs",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{service_name=\"vehicle-care-api\"} | json"}]
    }
  ]
}
